    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: plot_data.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/plot_data.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: data_collector.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/data_collector.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Sensor Monitor",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/comm_modul.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
        
    ]
}